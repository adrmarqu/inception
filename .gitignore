# Compiled and temporary files
*.o
*.d
*.swp
*.log
.DS_Store

# Persistent data volumes
data/
data

# Ignore any .env file anywhere in the repository
**/.env
.env
*.env

# Never ignore .env.example files
!.env.example
!**/.env.example
!*.env.example

# Ignore all files inside secrets/ except .gitkeep (keeps the folder in git)
secrets/*
!secrets/.gitkeep
