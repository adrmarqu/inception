# 42 Inception - Environment Variables Configuration (.env)
# Instructions:
# 1. Copy this file to 'srcs/.env':
#    cp .env.example srcs/.env
# 2. Fill in the variables below with your login and desired passwords.
# 3. Add '127.0.0.1 <DOMAIN_NAME>' to your /etc/hosts file.
# 4. Run 'make' from the repository root.

# 1. Domain Configuration
# Mandatory format for 42: <login>.42.fr
DOMAIN_NAME=adrmarqu.42.fr

# 2. Persistent Storage Path
# Base directory on host where Docker bind volumes will be stored.
# - On 42 school computers (mandatory): /home/<login>/data
DATA_PATH=/home/adrmarqu/data

# 3. MariaDB Configuration
MYSQL_DATABASE=wordpress
MYSQL_USER=wp_adrmarqu
MYSQL_PASSWORD=db_user_password_42
MYSQL_ROOT_PASSWORD=db_root_password_42

# Paths to secret files inside containers (mounted by Docker secrets)
MYSQL_PASSWORD_FILE=/run/secrets/db_password
MYSQL_ROOT_PASSWORD_FILE=/run/secrets/db_root_password

# 4. WordPress Configuration
WORDPRESS_DB_HOST=mariadb:3306
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wp_adrmarqu
WORDPRESS_DB_PASSWORD_FILE=/run/secrets/db_password

WORDPRESS_TITLE=Inception 42

# WordPress Administrator User
# IMPORTANT: 42 evaluation strictly forbids usernames containing 'admin' or 'administrator' (e.g. root, admin, administrator).
WORDPRESS_ADMIN_USER=superuser42
WORDPRESS_ADMIN_PASSWORD=wp_admin_password_42
WORDPRESS_ADMIN_EMAIL=superuser42@adrmarqu.42.fr
WORDPRESS_ADMIN_PASS_FILE=/run/secrets/wp_admin_password

# WordPress Regular User (Role: author)
WORDPRESS_USER=wp_adri
WORDPRESS_USER_PASSWORD=wp_user_password_42
WORDPRESS_USER_EMAIL=wp_adri@adrmarqu.42.fr
WORDPRESS_USER_PASS_FILE=/run/secrets/wp_user_password